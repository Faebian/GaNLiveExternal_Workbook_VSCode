{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build GaNLive External DLL",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Build-Deploy.ps1"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Check GaNLive External build prerequisites",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\Build-Deploy.ps1",
        "-CheckOnly"
      ],
      "problemMatcher": []
    }
  ]
}